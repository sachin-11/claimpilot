# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Used by the postgres container (docker-compose interpolation)
POSTGRES_USER=claimpilot
POSTGRES_PASSWORD=claimpilot
POSTGRES_DB=claimpilot

# Host-side ports. Change these if another project already uses 5432 / 6379 / 8000.
# (Containers always talk to each other on the default ports.)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
# the web app (nginx) on the host; change it when 3000 is taken
# FRONTEND_HOST_PORT=3000

# Hostnames are compose service names. From the host use localhost instead.
DATABASE_URL=postgresql+asyncpg://claimpilot:claimpilot@postgres:5432/claimpilot
REDIS_URL=redis://redis:6379/0
# Optional. Defaults to the database above with "_test" appended (created automatically).
# TEST_DATABASE_URL=postgresql+asyncpg://claimpilot:claimpilot@postgres:5432/claimpilot_test

# Seed users (make seed). Choose your own passwords; they are hashed with bcrypt.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_OFFICER_EMAIL=officer@example.com
SEED_OFFICER_PASSWORD=change-me-officer

# LLM providers. Keys ending in "replace-me" (or empty) are treated as "not set".
OPENAI_API_KEY=sk-replace-me
GROQ_API_KEY=gsk-replace-me
# Evaluation runs (make eval-e2e / eval-rag) call Claude with this key; the app itself does not.
ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=claude-haiku-5-5
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated list (React dev server later)
CORS_ORIGINS=http://localhost:5173

# --- Security (Module 10) ----------------------------------------------------------------------
# JWT_SECRET signs the access tokens. With APP_ENV=production the app refuses to start with the
# development default, a secret shorter than 32 characters, the default database credentials, a
# CORS origin on localhost, or well-known seed passwords. Generate one:  openssl rand -hex 32
JWT_SECRET=dev-insecure-jwt-secret-change-me
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# LOGIN_MAX_FAILURES=5            # per e-mail + IP ...
# LOGIN_WINDOW_MINUTES=15         # ... within this window, then 429 with Retry-After
# METRICS_TOKEN=                  # bearer token for the Prometheus scraper (admins can scrape too)
# Rate limits, requests per minute (the LLM pair applies to /policies/query, /claims/{id}/process, /extract)
# RATE_LIMIT_USER_PER_MINUTE=120
# RATE_LIMIT_IP_PER_MINUTE=300
# RATE_LIMIT_LLM_USER_PER_MINUTE=10
# RATE_LIMIT_LLM_IP_PER_MINUTE=30
# DAILY_LLM_BUDGET_INR=500        # estimated spend per day; above it new LLM work is refused (0 = off)
# OUTBOUND_TIMEOUT_SECONDS=30     # embeddings, MCP calls (LLM calls use LLM_TIMEOUT_SECONDS)

# --- Worker (Module 10) ------------------------------------------------------------------------
# Compose runs a `worker` service (arq on Redis): agent runs, extraction and ingestion happen there.
# USE_WORKER=false runs them inside the API process instead (single-process development).
# USE_WORKER=true
# WORKER_MAX_JOBS=4
# WORKER_JOB_TIMEOUT_SECONDS=1200
# WORKER_SHUTDOWN_WAIT_SECONDS=120
# WORKER_MAX_TRIES=4

# LLM resilience (optional, these are the defaults)
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
BREAKER_FAILURE_THRESHOLD=3
BREAKER_WINDOW_SECONDS=60
BREAKER_COOLDOWN_SECONDS=30

# Ingestion: skip top-level sections whose title matches (JSON list of regexes)
# EXCLUDE_SECTION_PATTERNS=["get in touch with us"]

# Retrieval (Module 4). Defaults shown; uncomment to change.
# VECTOR_TOP_K=20
# KEYWORD_TOP_K=20
# FUSED_TOP_K=20
# RRF_K=60
# RERANKER=none            # none | local | cohere
# RERANK_TOP_N=5
# COHERE_API_KEY=
# MULTI_QUERY=false
# CACHE_SIM_THRESHOLD=0.95
# CACHE_TTL_SECONDS=86400
# Build the image with the local reranker: INSTALL_LOCAL_RERANKER=true docker compose build backend

# MCP servers (Module 7). Bearer tokens for HTTP mode: "<caller identity>=<token>", comma-separated.
# The identity is written to audit_logs. Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_POLICY_DOCS_TOKENS=coverage-agent=replace-me-1,dev-client=replace-me-2
MCP_CLAIMS_DB_TOKENS=intake-agent=replace-me-3,risk-agent=replace-me-4,decision-agent=replace-me-5,dev-client=replace-me-6,supervisor-agent=replace-me-9
MCP_NOTIFY_TOKENS=notify-agent=replace-me-7,dev-client=replace-me-8
# Write tools (update_claim_status, save_decision_draft, send_status_update) exist only when true.
MCP_CLAIMS_DB_WRITE_ENABLED=true
MCP_NOTIFY_WRITE_ENABLED=true
NOTIFY_MAX_PER_CLAIM_PER_HOUR=5
# Caller identity for stdio mode (no token there)
# MCP_CALLER_ID=claude-desktop

# Agents (Module 8). Defaults shown; uncomment to change.
# AGENT_RECURSION_LIMIT=40
# COVERAGE_MAX_TOOL_CALLS=8
# RISK_REVIEW_THRESHOLD=50
# RISK_LLM_FLAGS=false
# EARLY_ADMISSION_DAYS=60
# NODE_RETRY_ATTEMPTS=3
# NOTIFY_CHANNEL=email

# End-to-end eval (Module 9). Defaults shown; uncomment to change.
# EVAL_DATABASE_URL=postgresql+asyncpg://...   # default: <main db>_eval; must contain "eval"
# EVAL_CONCURRENCY=3
# EVAL_RUN_TIMEOUT=600
# EVAL_JUDGE_MODEL=gpt-4o

# Observability (Module 10). Tracing is optional: leave the Langfuse keys empty and the app runs untraced.
# Self-hosted (make langfuse-up): the keys below are created by the stack itself on first start.
# Langfuse Cloud: create a project, paste its keys and set LANGFUSE_BASE_URL to your region's URL.
# LANGFUSE_PUBLIC_KEY=pk-lf-claimpilot-dev
# LANGFUSE_SECRET_KEY=sk-lf-claimpilot-dev
# LANGFUSE_BASE_URL=http://langfuse-web:3000
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=change-me-langfuse
# USD_INR_RATE=88.0   # cost metrics and the daily budget are in INR; set today's rate

# Web app (Module 11). The browser talks to its own origin and nginx / the Vite proxy forwards /api, so no CORS is
# needed; CORS_ORIGINS only matters when something else calls the API from a browser.
# MOCK_LLM=true replaces the chat model and the embeddings with deterministic fakes (no API keys, no cost): demos and
# the browser tests (`make e2e-up`). The app refuses to start with MOCK_LLM=true and APP_ENV=production.
# MOCK_LLM=false
# AUTH_COOKIE_NAME=claimpilot_refresh
# AUTH_COOKIE_PATH=      # empty: derived from X-Forwarded-Prefix (/api behind nginx) + /auth
