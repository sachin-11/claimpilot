# Template for the server's .env. Do not edit by hand: `deploy/bootstrap-env.sh <domain>` fills every
# double-underscore marker with a fresh random value (or the value you give it) and writes ../.env.
# Never commit the result.

APP_ENV=production
LOG_LEVEL=INFO
DOMAIN=__DOMAIN__

# Postgres (the same password is inside DATABASE_URL)
POSTGRES_USER=claimpilot
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=claimpilot
DATABASE_URL=postgresql+asyncpg://claimpilot:__POSTGRES_PASSWORD__@postgres:5432/claimpilot
REDIS_URL=redis://redis:6379/0

# Same origin as the web app (the browser only talks to https://<domain>; CORS is not really used)
CORS_ORIGINS=https://__DOMAIN__

# Accounts created by `app.scripts.seed` (printed once by the bootstrap script)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=__ADMIN_PASSWORD__
SEED_OFFICER_EMAIL=officer@example.com
SEED_OFFICER_PASSWORD=__OFFICER_PASSWORD__

JWT_SECRET=__JWT_SECRET__

# LLM. The app uses OpenAI for the chat model and for embeddings. Groq / Anthropic are optional.
OPENAI_API_KEY=__OPENAI_API_KEY__
PRIMARY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# A public link with a real API key behind it: cap the spend. New LLM work is refused above this (INR per day).
DAILY_LLM_BUDGET_INR=100
USD_INR_RATE=88.0
RATE_LIMIT_LLM_USER_PER_MINUTE=10
RATE_LIMIT_LLM_IP_PER_MINUTE=30

# Retrieval: the local reranker fixes wrong "not covered by the text" answers; 10 candidates keeps it near 6 s
RERANKER=local
FUSED_TOP_K=10

# Worker
USE_WORKER=true

# MCP servers: one token per agent identity (the identity lands in the audit log)
MCP_POLICY_DOCS_TOKENS=coverage-agent=__TOKEN_COVERAGE__
MCP_CLAIMS_DB_TOKENS=intake-agent=__TOKEN_INTAKE__,risk-agent=__TOKEN_RISK__,decision-agent=__TOKEN_DECISION__,supervisor-agent=__TOKEN_SUPERVISOR__
MCP_NOTIFY_TOKENS=notify-agent=__TOKEN_NOTIFY__
MCP_CLAIMS_DB_WRITE_ENABLED=true
MCP_NOTIFY_WRITE_ENABLED=true

# Scraper token for GET /metrics (optional, nothing scrapes it in this setup)
METRICS_TOKEN=__METRICS_TOKEN__
